// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ProjectStat {
  slug       String           @id
  views      ProjectViewTracker[]
  totalViews Int              @default(0)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model ProjectViewTracker {
  id         Int      @id @default(autoincrement())
  slug       String
  visitorId  String
  lastSeen   DateTime @updatedAt
  count      Int      @default(1)
  country    String
  projectStat   ProjectStat @relation(fields: [slug], references: [slug])
  @@unique([slug, visitorId])
}

model BlogStat {
  slug       String           @id
  views      BlogViewTracker[]
  totalViews Int              @default(0)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model BlogViewTracker {
  id         Int      @id @default(autoincrement())
  slug       String
  visitorId  String
  lastSeen   DateTime @updatedAt
  count      Int      @default(1)
  country    String
  blogStat   BlogStat @relation(fields: [slug], references: [slug])
  @@unique([slug, visitorId])
}


model Experience {
  id          Int      @id @default(autoincrement()) 
  company     String
  role        String
  description String?
  companyUrl  String?
  companyLogo String?
  location    String?
  start       DateTime
  end         DateTime?
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

model Donor {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  socialUrl String?
  metadata  Json?
  createdAt  DateTime @default(now())
  donations  Donation[]
}

model Donation {
  id                Int      @id @default(autoincrement())
  donorId           Int
  donor             Donor    @relation(fields: [donorId], references: [id], onDelete: Cascade)
  checkoutId        String   @unique
  amount            Int
  currency          String   @default("usd")
  frequency         String   @default("once") // "once" | "month"
  subscriptionId    String?
  subscriptionStatus String? // "active" | "cancelled" | "past_due" | "revoked"
  message           String?
  status            String   @default("completed") // "completed" | "refunded"
  createdAt         DateTime @default(now())
}

model Education {
  id          Int      @id @default(autoincrement()) 
  school      String
  degree      String
  field       String
  description String?
  start       DateTime
  end         DateTime?
  created_at  DateTime @default(now()) 
  updated_at  DateTime @updatedAt
}

enum TestimonialCategory {
  SOFTWARE_ENGINEER
  GUESTBOOK
  MENTOR
}

model Testimonial {
  id        Int                 @id @default(autoincrement())
  quote     String              @db.Text
  name      String
  role      String
  avatar    String
  category  TestimonialCategory
  order     Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}
